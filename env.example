# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local — it's already gitignored.

# TypeSafe AI API key. Get one at https://console.typesafe.ai/keys
# If unset (or DECISION_ENGINE=rules), the app falls back to the deterministic
# RuleDecisionMaker adapter and never calls the network.
TYPESAFE_API_KEY=

# Which DecisionMaker adapter to use: "jev" or "rules".
# Default: "jev" if TYPESAFE_API_KEY is set, otherwise "rules".
DECISION_ENGINE=

# Optional: override the pinned Jev model version (defaults to jev-1.13.0;
# see the determinism experiment in scripts/determinism.ts and the README
# for why a pinned version is used instead of "jev-latest").
TYPESAFE_MODEL=
