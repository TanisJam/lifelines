# Copy this file to deploy/.env (gitignored) and fill in your own values, then:
#   docker compose -f deploy/compose.yaml up -d --build

# TypeSafe AI API key. Get one at https://console.typesafe.ai/keys
# If unset (or DECISION_ENGINE=rules), the app falls back to the deterministic
# RuleDecisionMaker adapter and never calls the network.
TYPESAFE_API_KEY=

# Which DecisionMaker adapter to use: "jev" or "rules".
# Default: "jev" if TYPESAFE_API_KEY is set, otherwise "rules".
DECISION_ENGINE=

# Optional: override the pinned Jev model version (defaults to jev-1.13.0;
# see the determinism experiment in scripts/determinism.ts and the README
# for why a pinned version is used instead of "jev-latest").
TYPESAFE_MODEL=

# Not needed here: DATA_DIR is set to /data by the Dockerfile itself (a mounted volume,
# lifelines-data in deploy/compose.yaml) - don't override it unless you're changing the
# volume/mount layout.

# Optional: how many lives/worlds each stay hydrated in memory at once (an LRU cache per store;
# an evicted one is transparently reloaded from SQLite on its next access). Defaults to 16.
STORE_CACHE_SIZE=

